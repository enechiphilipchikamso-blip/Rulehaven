# Public application configuration
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Rulehaven

# Local PostgreSQL development service
POSTGRES_DB=rulehaven_dev
POSTGRES_USER=rulehaven_dev
POSTGRES_PASSWORD=rulehaven_dev_password
DATABASE_URL=postgresql://rulehaven_dev:rulehaven_dev_password@localhost:5432/rulehaven_dev?schema=public

# Local MinIO / S3-compatible development service
MINIO_ROOT_USER=rulehaven_dev
MINIO_ROOT_PASSWORD=rulehaven-dev-secret
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=rulehaven-local
S3_ACCESS_KEY_ID=rulehaven_dev
S3_SECRET_ACCESS_KEY=rulehaven-dev-secret